# Copy to .env and fill in values:
#   cp .env.example .env
#
# Generate secrets:
#   openssl rand -hex 32 | sed 's/^/sk-master-/'   # LITELLM_MASTER_KEY
#   openssl rand -hex 32                            # WEBUI_SECRET_KEY
#   openssl rand -hex 16                            # REDIS_PASSWORD, OPENWEBUI_ADMIN_PASSWORD
#   openssl rand -hex 32                            # SEARXNG_SECRET

# --- LAN / URLs ---
LAN_IP=<your-mac-lan-ip>
PROXY_BASE_URL=https://<your-mac-lan-ip>

# --- LiteLLM ---
DATABASE_URL=postgresql://litellm:litellm@localhost:5432/litellm
LITELLM_MASTER_KEY=sk-master-<openssl-rand-hex-32>

# --- Open WebUI ---
WEBUI_SECRET_KEY=<openssl-rand-hex-32>
OPENWEBUI_ADMIN_EMAIL=admin@xorora.com
OPENWEBUI_ADMIN_PASSWORD=<openssl-rand-hex-16>
OPENWEBUI_LITELLM_KEY=<litellm-virtual-key-from-setup-script>
OPENWEBUI_ENABLE_SIGNUP=false

# --- Redis (Docker) — LiteLLM cache/router state; Open WebUI websockets ---
REDIS_PASSWORD=<openssl-rand-hex-16>
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- Web search (Research task mode) — default: self-hosted SearXNG in Docker ---
# To use Tavily free tier instead: WEB_SEARCH_ENGINE=tavily and set TAVILY_API_KEY
WEB_SEARCH_ENGINE=searxng
SEARXNG_SECRET=<openssl-rand-hex-32>
SEARXNG_QUERY_URL=http://searxng:8080/search?q=<query>
SEARXNG_LANGUAGE=en
WEB_SEARCH_RESULT_COUNT=5
WEB_SEARCH_CONCURRENT_REQUESTS=10
WEB_LOADER_CONCURRENT_REQUESTS=10
TAVILY_API_KEY=

# --- Optional Google OAuth (Open WebUI) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# ENABLE_OAUTH_SIGNUP=false
# OAUTH_MERGE_ACCOUNTS_BY_EMAIL=false
